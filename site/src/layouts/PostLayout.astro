---
import type { CollectionEntry } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import BaseLayout from './BaseLayout.astro'
import { SERIES_LENGTH } from '../lib/series.ts'
import { home } from '../lib/paths.ts'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { title, thesis, commit, cover, coverAlt, order } = post.data
const repo = 'https://github.com/baradelli/nine-commits'

/*
 * The social card, as a raster the scrapers will actually take. `<Image>`
 * below serves a WebP, which is right for the page and wrong for a share
 * card — LinkedIn does not render it — so the same cover is emitted a second
 * time as the PNG it was generated as, at its native 1200x627.
 */
const card = await getImage({ src: cover, format: 'png' })
---

<BaseLayout
  title={`${title} — Nine Commits`}
  description={thesis}
  type="article"
  image={card.src}
  imageAlt={coverAlt}
  imageWidth={cover.width}
  imageHeight={cover.height}
>
  <header class="site-head">
    <a class="masthead" href={home}>Nine Commits</a>
  </header>

  <main class="measured" id="main">
    <!-- The measure tracks reading position. Scroll-driven and JavaScript
         free; where scroll timelines are unsupported the track stays empty
         rather than being faked with a script. -->
    <div class="rail rail--reading" aria-hidden="true">
      <span class="rail__fill"></span>
    </div>

    <article class="spread">
      <p class="marginal">
        <span>Commit {order} of {SERIES_LENGTH}</span><br /><code>{commit}</code>
      </p>

      <header class="post__header">
        <h1 class="title">{title}</h1>
        <p class="lede">{thesis}</p>
      </header>

      <Image class="post__cover" src={cover} alt={coverAlt} loading="eager" />

      <div class="prose">
        <slot />
      </div>

      <footer class="post__footer">
        <p>
          The agent in this post is tagged <code>{commit}</code> in the
          repository. <a href={`${repo}/releases/tag/${commit}`}>
            Read the code at that tag
          </a> and run the same task the trace recorded.
        </p>
      </footer>
    </article>
  </main>
</BaseLayout>
