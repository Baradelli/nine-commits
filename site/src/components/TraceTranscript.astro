---
import { FrameView } from './Frame.tsx'

/*
 * The no-script fallback. It renders the same `FrameView` the island does,
 * so a reader with scripting off gets the trace properly typeset as
 * dialogue rather than a JSON dump — the argument of a post never depends
 * on the player running.
 *
 * The measure does not appear here: with every frame printed at once there
 * is no position to report, and the site has exactly one structural device
 * so it is not spent on decoration.
 */
interface Props {
  trace: {
    task: string
    model: string
    commit: string
    frames: Array<{ type: string; [key: string]: unknown }>
  }
  /*
   * What this recording is, when a post prints more than one of them. With
   * the player gone there is no switch to say which run you are looking at,
   * so the margin has to.
   */
  label?: string
}

const { trace, label = 'Recorded run' } = Astro.props
---

<noscript>
  <section
    class="transcript-block"
    aria-label={`${label} transcript: ${trace.task}`}
  >
    <div class="spread">
      <p class="marginal">{label}</p>

      <header>
        <h2 class="trace__task">{trace.task}</h2>
        <p class="trace__note">
          Recorded from {trace.model} at commit {trace.commit}. The
          step-through needs JavaScript, so the whole run is printed here
          instead.
        </p>
      </header>

      <ol class="transcript full">
        {trace.frames.map((frame) => <FrameView frame={frame} />)}
      </ol>
    </div>
  </section>
</noscript>
