{
  "name": "nine-commits",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "agent",
    "site"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "validate": "tsx tools/validate-traces.ts",
    "eval": "tsx tools/run-evals.ts",
    "record": "tsx tools/record-trace.ts",
    "covers": "tsx tools/make-covers.ts",
    "e2e": "playwright test",
    "judge": "tsx --env-file=agent/.env tools/run-judge.ts",
    "roster": "tsx --env-file=agent/.env tools/run-roster.ts",
    "roster:tally": "tsx tools/roster/report.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.69",
    "@fontsource/literata": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.1",
    "ai": "^7.0.105",
    "gray-matter": "^4.0.3",
    "satori": "^0.33.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
